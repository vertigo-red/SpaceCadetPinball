#!/bin/sh
set -eu

app_dir=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ -z "${SDL_SOUNDFONTS:-}" ]; then
    export SDL_SOUNDFONTS="$app_dir/usr/share/sounds/sf2/TimGM6mb.sf2"
fi

# Preserve the current working directory when it already contains game data.
# Otherwise, allow users to place their data next to the AppImage itself.
has_game_data() {
    for data_file in CADET.DAT PINBALL.DAT DEMO.DAT cadet.dat pinball.dat demo.dat; do
        if [ -f "$1/$data_file" ]; then
            return 0
        fi
    done
    return 1
}
if ! has_game_data "$PWD" && [ -n "${APPIMAGE:-}" ]; then
    image_dir=$(dirname -- "$APPIMAGE")
    if has_game_data "$image_dir"; then
        cd -- "$image_dir"
    fi
fi

exec "$app_dir/usr/bin/SpaceCadetPinball" "$@"
